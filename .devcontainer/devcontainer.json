// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet-postgres
{
    "name": "C# (.NET) and PostgreSQL",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	
	// features to add to the dev container. More info: https://containers.dev/features
	"features": {
		// install Node.js (via nvm)
		"ghcr.io/devcontainers/features/node:2": {
			"nodeGypDependencies": true,
			"version": "lts",
			"npmVersion": "lts",
			"pnpmVersion": "none",
			"nvmVersion": "latest"
		},
		// install .NET CSharpier
		"ghcr.io/nikiforovall/devcontainer-features/dotnet-csharpier:1": {}
	},

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"csharpier.csharpier-vscode",
				"google.google-antigravity"
			]
		}
	},

	// Bind mount host Antigravity directories (.gemini and .config/antigravity)
	// to share login sessions, project configurations, and conversation
	// histories seamlessly between the host and devcontainer, ensuring full
	// persistence across container rebuilds.
	"mounts": [
		"source=${localEnv:HOME}/.gemini,target=/home/vscode/.gemini,type=bind",
		"source=${localEnv:HOME}/.config/antigravity,target=/home/vscode/.config/antigravity,type=bind"
	],

	// explicitly forwarded ports for the application and database
	"forwardPorts": [5000, 5001, 5432],
	"portsAttributes": {
		"5000": {
			"label": "Application (HTTP)",
			"onAutoForward": "silent"
		},
		"5001": {
			"label": "Application (HTTPS)",
			"protocol": "https",
			"onAutoForward": "silent"
		},
		"5432": {
			"label": "PostgreSQL",
			"onAutoForward": "silent"
		}
	},
	// ignore background processes / compiler IPC from automatically forwarding random ports
	"otherPortsAttributes": {
		"onAutoForward": "ignore"
	},

    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": "bash ./.devcontainer/scripts/lifecycle/postcreate.sh"

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
